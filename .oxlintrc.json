{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "react", "react-hooks"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "dist",
    "playwright/.cache",
    "playwright-report",
    "test-results",
    "coverage",
    "public/mockServiceWorker.js",
    "docs/day-schedule.simulator.js"
  ]
}
