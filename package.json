{
  "name": "mad-dev-room-booking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ./scripts/dev.ts",
    "build": "bun ./scripts/build.ts",
    "preview": "bun ./scripts/preview.ts",
    "test": "bun test",
    "test:unit": "bun test src",
    "test:coverage": "bun test src --coverage",
    "test:e2e": "playwright test",
    "test:ct": "playwright test -c playwright-ct.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test:unit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@rzv/make-brand": "^0.4.1",
    "@tanstack/react-router": "1.169.2",
    "@xstate/react": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^4.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remeda": "^2.54.1",
    "tailwind-merge": "^3.7.0",
    "xstate": "5.33.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "1.62.1",
    "@playwright/test": "1.62.1",
    "@statelyai/inspect": "^0.7.2",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "msw": "^2.15.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
